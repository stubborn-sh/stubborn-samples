<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>
    <groupId>com.example</groupId>
    <artifactId>boot-version-matrix-boot-4-0-earliest</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Boot Version Matrix — Spring Boot 4.0.0 (earliest 4.0)</name>
    <description>
        The earliest Spring Boot 4.0, and the widest version gap this matrix covers.

        Boot 4.0.0 manages Jetty 12.1.4. Stubborn's BOM supplies the ee10 servlet layer at
        its own ${jetty.version}, currently 12.1.14, so the stub server runs an ee10 ten
        patch releases AHEAD of the core underneath it. That is the arrangement worth
        proving: gh-142 was a minor-line split (ee10 12.0 against a 12.1 core) and was
        fatal, so the open question is whether a patch-level gap inside one minor line is
        benign. The tests answer it rather than assuming.
    </description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <stubborn-contract.version>0.2.1-SNAPSHOT</stubborn-contract.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              Stubborn's BOM, imported ahead of the Boot BOM the parent contributes. From
              0.2.1 the only Jetty it manages is org.eclipse.jetty.ee10, which Boot does not
              manage at all; Boot keeps the core and the ee11 layer. Nothing below needs a
              jetty-ee10-bom import or an exclusion.
            -->
            <dependency>
                <groupId>sh.stubborn</groupId>
                <artifactId>stubborn-contract-dependencies</artifactId>
                <version>${stubborn-contract.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <!-- Swap the default container for Jetty, the standard Boot recipe. -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jetty</artifactId>
        </dependency>
        <dependency>
            <groupId>sh.stubborn</groupId>
            <artifactId>stubborn-contract-starter-stub-runner</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- Boot's own Jetty, so the tests can compare against it instead of
                             hardcoding a version that goes stale when Boot moves. -->
                        <boot.jetty.version>${jetty.version}</boot.jetty.version>
                        <boot.version>4.0.0</boot.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
      stubborn-contract is pinned to a SNAPSHOT while the gh-142 fix rides to a release;
      scripts/set-samples-version.sh rewrites it to 0.2.1 when 0.2.1 ships. Releases are
      disabled here, so a released version still comes from Central.
    -->
    <repositories>
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <snapshots><enabled>true</enabled></snapshots>
            <releases><enabled>false</enabled></releases>
        </repository>
    </repositories>
</project>
