<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <groupId>com.example</groupId>
    <artifactId>classpath-matrix-boot-jetty</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Classpath Matrix — Spring Boot 4.1 on Jetty</name>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <stubborn-contract.version>0.2.2</stubborn-contract.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              Boot manages Jetty core and its ee11 layer, but not ee10, which is what
              wiremock-jetty12 is built against. Unmanaged it resolves to 12.0.30, a minor
              line below Boot's core, and the stub server dies in ServletContextHandler's
              static initialiser (stubborn-sh/stubborn#142). ${jetty.version} comes from
              spring-boot-starter-parent, so this follows Boot rather than freezing a version.

              DELETE THIS BLOCK when stubborn-contract.version reaches 0.2.1: from then on
              Stubborn's own BOM manages ee10 at Boot's Jetty line and this is redundant.
            -->
            <dependency>
                <groupId>org.eclipse.jetty.ee10</groupId>
                <artifactId>jetty-ee10-bom</artifactId>
                <version>${jetty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <!-- Swap the default container for Jetty, the standard Boot recipe. -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- The combination that used to fail: Boot aligns Jetty core to 12.1.x. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jetty</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          The stub runner, plain. No exclusions and no shaded WireMock: with ee10 aligned to
          Boot's Jetty (see dependencyManagement) the stub server and the application share
          one Jetty happily, and Stubborn's response-template helpers keep working - which
          the shaded wiremock-standalone costs you, because it relocates Handlebars too.
        -->
        <dependency>
            <groupId>sh.stubborn</groupId>
            <artifactId>stubborn-contract-starter-stub-runner</artifactId>
            <version>${stubborn-contract.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
