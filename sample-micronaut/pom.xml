<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>sample-micronaut</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Sample Micronaut — Consumer Stub Runner</name>
    <description>Micronaut consumer that runs Stubborn Contract stubs via a @MicronautTest, without Spring</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <micronaut.version>4.10.17</micronaut.version>
        <!--
          Align Jetty to the version the stub runner's embedded WireMock (3.13.2) is tested against.
          The Micronaut platform BOM otherwise forces core jetty-* to 12.1.2 while WireMock's
          jetty-ee10-* servlet artifacts stay at 12.0.x, and the mismatched pair throws
          NoSuchMethodError (Environment.ensure) at stub-server start. Jetty is only present here
          transitively via WireMock (test scope) — Micronaut itself runs on Netty — so pinning it is
          safe. The two BOM imports below are declared first so they win over micronaut-platform.
        -->
        <jetty.version>12.0.37</jetty.version>
        <!--
          The Stubborn Contract adapter is pinned explicitly rather than via the
          stubborn-contract-dependencies BOM on purpose: that BOM also manages shared transitive
          libraries (netty, jackson) which the Micronaut platform BOM already manages for its own
          tested versions. Importing both would let one override the other's aligned versions.
          Pinning the single adapter artifact keeps the Micronaut BOM authoritative.
        -->
        <stubborn-contract.version>0.1.0-SNAPSHOT</stubborn-contract.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Jetty alignment for WireMock — declared before micronaut-platform so it wins. -->
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-bom</artifactId>
                <version>${jetty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty.ee10</groupId>
                <artifactId>jetty-ee10-bom</artifactId>
                <version>${jetty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.micronaut.platform</groupId>
                <artifactId>micronaut-platform</artifactId>
                <version>${micronaut.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Micronaut consumer application: DI + declarative HTTP client. -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-inject</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-http-client</artifactId>
        </dependency>
        <!-- Provides the JsonMapper bean the Micronaut HTTP client requires at wiring time. -->
        <dependency>
            <groupId>io.micronaut</groupId>
            <artifactId>micronaut-jackson-databind</artifactId>
        </dependency>

        <!-- Test: Micronaut Test JUnit 5 + the Spring-free Stubborn Contract stub-runner core.
             The tiny Micronaut adapter (TestPropertyProvider base class) is embedded in this sample
             under src/test/java/com/example/stubrunner — in 0.1.0 it ships as sample code rather than
             a published module. -->
        <dependency>
            <groupId>io.micronaut.test</groupId>
            <artifactId>micronaut-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>sh.stubborn</groupId>
            <artifactId>stubborn-contract-stub-runner</artifactId>
            <version>${stubborn-contract.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Micronaut generates bean definitions and the declarative @Client at compile
                         time, so its annotation processors must be on the processor path. Versions
                         are resolved from the imported micronaut-platform BOM. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.micronaut</groupId>
                            <artifactId>micronaut-inject-java</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <snapshots><enabled>true</enabled></snapshots>
            <releases><enabled>false</enabled></releases>
        </repository>
    </repositories>
</project>
