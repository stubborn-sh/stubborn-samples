<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>stubborn-sqs</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Sample SQS — Spring-free SQS messaging building block (prototype)</name>
    <description>
        Prototype of a Spring-free MessageVerifierSender/Receiver pair for Amazon SQS.
        Lives in the samples while the design settles; promoted to
        sh.stubborn:stubborn-contract-messaging-sqs once the conformance suite is green,
        because that module is revapi-gated and its public types are a commitment.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <stubborn-contract.version>0.1.3</stubborn-contract.version>
        <aws-sdk.version>2.29.52</aws-sdk.version>
        <junit.version>5.11.4</junit.version>
        <assertj.version>3.27.3</assertj.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <slf4j.version>2.0.16</slf4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- MessageVerifierSender/Receiver, MessagePayloads, ContractMessage. -->
        <dependency>
            <groupId>sh.stubborn</groupId>
            <artifactId>stubborn-contract-verifier</artifactId>
            <version>${stubborn-contract.version}</version>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
          The transport-neutral conformance suite. Running it is the real proof that a new
          transport behaves like the others; the wire-format unit tests only pin the part
          that needs no broker.
        -->
        <dependency>
            <groupId>sh.stubborn</groupId>
            <artifactId>stubborn-contract-messaging-tck</artifactId>
            <version>${stubborn-contract.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>localstack</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!--
                      The conformance suite needs a Docker daemon for LocalStack. Skipping it
                      where none exists keeps the wire-format tests runnable everywhere, and CI
                      (which has Docker) still runs the full suite.
                    -->
                    <excludedGroups>${surefire.excluded.groups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>default-groups</id>
            <activation>
                <property>
                    <name>!surefire.excluded.groups</name>
                </property>
            </activation>
            <properties>
                <surefire.excluded.groups></surefire.excluded.groups>
            </properties>
        </profile>
    </profiles>

</project>
